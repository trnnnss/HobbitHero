<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="?android:attr/colorBackground">

    <!-- Geri butonu + Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        android:background="?attr/colorSurface"
        app:elevation="4dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarUserProfile"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@android:drawable/ic_media_previous"
            app:title="Profil" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="80dp">

            <!-- Profil Başlığı -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <!-- Avatar -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivUserAvatar"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_turtle"
                    android:background="#E2E8F0"
                    android:padding="8dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent"/>

                <!-- İstatistikler -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:layout_marginStart="20dp"
                    android:weightSum="3">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/tvUserPostCount"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textStyle="bold" android:textSize="18sp"
                            android:textColor="?attr/colorOnBackground"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="gönderi" android:textSize="11sp" android:textColor="?attr/colorSecondary"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/tvUserFollowerCount"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textStyle="bold" android:textSize="18sp"
                            android:textColor="?attr/colorOnBackground"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="takipçi" android:textSize="11sp" android:textColor="?attr/colorSecondary"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/tvUserFollowingCount"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textStyle="bold" android:textSize="18sp"
                            android:textColor="?attr/colorOnBackground"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="takip" android:textSize="11sp" android:textColor="?attr/colorSecondary"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- İsim + Bio -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/tvUserDisplayName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kullanıcı Adı"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="?attr/colorOnBackground"/>

                <TextView
                    android:id="@+id/tvUserHandle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@handle"
                    android:textSize="12sp"
                    android:textColor="?attr/colorSecondary"/>

                <TextView
                    android:id="@+id/tvUserBio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Bio..."
                    android:textSize="13sp"
                    android:textColor="?attr/colorOnBackground"/>

                <!-- XP + Level rozeti -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/tvUserXpBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐ Sv.5 · 560 XP"
                        android:textSize="12sp"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Takip Et / Takip Ediliyor Butonu -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFollowUnfollow"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp"
                android:text="Takip Et"
                app:cornerRadius="8dp"/>

            <!-- Ayırıcı -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorOutline"/>

            <!-- Grid: Kullanıcının postları -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📸  Gönderiler"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?attr/colorSecondary"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="4dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvUserPosts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
