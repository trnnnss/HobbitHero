<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="?android:attr/colorBackground">

    <!-- Başlık Kartı -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp"
        android:background="?attr/colorPrimaryContainer">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏆 Liderlik Tablosu"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnPrimaryContainer" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="XP puanına göre en iyi alışkanlık kahramanları"
            android:textSize="13sp"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:alpha="0.8"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Filtre Tabları -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutLeaderboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="fixed"
        app:tabGravity="fill"
        android:elevation="2dp"/>

    <!-- Yükleniyor -->
    <ProgressBar
        android:id="@+id/progressLeaderboard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Sıralama Listesi — ListView -->
    <ListView
        android:id="@+id/listViewLeaderboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="?attr/colorOutline"
        android:dividerHeight="1dp"
        android:paddingBottom="80dp"
        android:clipToPadding="false"
        android:scrollbars="none" />

</LinearLayout>
