<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.hobbithero.ui.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.hobbithero.ui.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.hobbithero.ui.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_dashboardFragment_to_detailFragment"
            app:destination="@id/detailFragment" />
    </fragment>

    <fragment
        android:id="@+id/detailFragment"
        android:name="com.example.hobbithero.ui.DetailFragment"
        android:label="Detail"
        tools:layout="@layout/fragment_detail" />

    <fragment
        android:id="@+id/exploreFragment"
        android:name="com.example.hobbithero.ui.ExploreFragment"
        android:label="Keşfet"
        tools:layout="@layout/fragment_explore">
        <action
            android:id="@+id/action_exploreFragment_to_userProfileFragment"
            app:destination="@id/userProfileFragment" />
        <action
            android:id="@+id/action_exploreFragment_to_createPostFragment"
            app:destination="@id/createPostFragment" />
        <action
            android:id="@+id/action_exploreFragment_to_userSearchFragment"
            app:destination="@id/userSearchFragment" />
    </fragment>

    <fragment
        android:id="@+id/userProfileFragment"
        android:name="com.example.hobbithero.ui.UserProfileFragment"
        android:label="Kullanıcı Profili"
        tools:layout="@layout/fragment_user_profile">
        <argument
            android:name="uid"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <fragment
        android:id="@+id/mapFragment"
        android:name="com.example.hobbithero.ui.MapFragment"
        android:label="Harita"
        tools:layout="@layout/fragment_map" />

    <fragment
        android:id="@+id/leaderboardFragment"
        android:name="com.example.hobbithero.ui.LeaderboardFragment"
        android:label="Sıralama"
        tools:layout="@layout/fragment_leaderboard" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.hobbithero.ui.ProfileFragment"
        android:label="Profil"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profileFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_profileFragment_to_editProfileFragment"
            app:destination="@id/editProfileFragment" />
        <action
            android:id="@+id/action_profileFragment_to_postDetailFragment"
            app:destination="@id/postDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.example.hobbithero.ui.EditProfileFragment"
        android:label="Profili Düzenle"
        tools:layout="@layout/fragment_edit_profile" />

    <fragment
        android:id="@+id/bossChallengeFragment"
        android:name="com.example.hobbithero.ui.BossChallengeFragment"
        android:label="Patron Savaşı"
        tools:layout="@layout/fragment_boss_challenge" />

    <fragment
        android:id="@+id/createPostFragment"
        android:name="com.example.hobbithero.ui.CreatePostFragment"
        android:label="Yeni Gönderi"
        tools:layout="@layout/fragment_create_post" />

    <fragment
        android:id="@+id/postDetailFragment"
        android:name="com.example.hobbithero.ui.PostDetailFragment"
        android:label="Gönderi Detayı"
        tools:layout="@layout/fragment_post_detail" />

    <fragment
        android:id="@+id/userSearchFragment"
        android:name="com.example.hobbithero.ui.UserSearchFragment"
        android:label="Kullanıcı Ara"
        tools:layout="@layout/fragment_user_search">
        <action
            android:id="@+id/action_userSearchFragment_to_userProfileFragment"
            app:destination="@id/userProfileFragment" />
    </fragment>

</navigation>
